{
  "name": "sdkbot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:up": "tsx src/db/migrate.ts up",
    "migrate:down": "tsx src/db/migrate.ts down",
    "notify": "tsx src/scripts/notify.ts",
    "bridge": "tsx src/scripts/bridge.ts",
    "telegram-bridge": "tsx src/scripts/telegramBridge.ts",
    "wait-answer": "tsx src/scripts/waitForAnswer.ts",
    "watch-cursor": "tsx src/scripts/watchCursor.ts",
    "watch-cursor-telegram": "tsx src/scripts/watchCursorTelegram.ts",
    "deliver-answer": "tsx src/scripts/deliverAnswer.ts",
    "ask-slack-mcp": "tsx src/mcp/server.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@slack/socket-mode": "^3.0.1",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "eslint": "^9.18.0",
    "node-pg-migrate": "^7.9.1",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}

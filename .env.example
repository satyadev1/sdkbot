# Postgres connection used by the app and by migrations
DATABASE_URL=postgres://focuspilot:focuspilot@localhost:5100/focuspilot

NODE_ENV=development

# Slack Incoming Webhook URL used by the notify.slack job handler.
# Create one at api.slack.com/apps -> your app -> Incoming Webhooks.
SLACK_WEBHOOK_URL=

# Bot token (xoxb-...) and app-level token (xapp-...) for the two-way Slack
# bridge (Socket Mode). Create/enable Socket Mode on the same Slack app.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Channel the bridge posts questions into and listens for thread replies on.
SLACK_CHANNEL_ID=

# Your Slack member id (U...), so posts can @-mention you. A display name or
# username will not notify — only the member id does. Find it via your avatar
# -> Profile -> the "..." menu -> Copy member ID.
SLACK_MENTION_USER_ID=
# Master switch for @-mentions. Defaults to on once a member id is set.
SLACK_MENTION_ENABLED=true
# questions = tag only posts awaiting an answer; all = tag every post.
SLACK_MENTION_SCOPE=questions

# How a recorded Slack answer reaches a waiting prompt (`deliver-answer`).
# clipboard = copied for you to paste; needs no permission.
# keystroke = pasted for you; needs Accessibility access for osascript
#   (System Settings -> Privacy & Security -> Accessibility -> your terminal).
DELIVER_MODE=clipboard
# Bundle id that must be frontmost before delivering, e.g. dev.warp.Warp-Stable.
# Leave empty to allow any recognised terminal.
DELIVER_EXPECTED_APP=
# Press Return after delivering. Off by default, so you confirm the answer.
DELIVER_SUBMIT=false

# Bot token for the two-way Telegram bridge. Create one via @BotFather in
# Telegram (/newbot). Bots cannot message you first, so send it one DM
# before the bridge can capture your chat id below.
TELEGRAM_BOT_TOKEN=
# Chat id the bridge posts questions into and listens for replies on.
TELEGRAM_CHAT_ID=
